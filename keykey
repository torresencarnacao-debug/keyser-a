                        elseif GetEntityType(entityHit) == 1 then
                            local v = GetVehiclePedIsIn(entityHit, false)
                            if v and v ~= 0 and DoesEntityExist(v) then targetVeh = v end
                        end
                    end
                else
                    local camPos = GetGameplayCamCoord()
                    local camRot = GetGameplayCamRot(2)
                    local pitch  = math.rad(camRot.x)
                    local yaw    = math.rad(camRot.z)
                    local dirX   = -math.sin(yaw) * math.cos(pitch)
                    local dirY   =  math.cos(yaw) * math.cos(pitch)
                    local dirZ   =  math.sin(pitch)
                    local ray = StartExpensiveSynchronousShapeTestLosProbe(
                        camPos.x, camPos.y, camPos.z,
                        camPos.x + dirX * 10000.0,
                        camPos.y + dirY * 10000.0,
                        camPos.z + dirZ * 10000.0,
                        -1, playerPed, 10
                    )
                    local _, hit, _, _, entityHit = GetShapeTestResult(ray)
                    if hit and entityHit and DoesEntityExist(entityHit) then
                        if GetEntityType(entityHit) == 2 then
                            targetVeh = entityHit
                        elseif GetEntityType(entityHit) == 1 then
                            local v = GetVehiclePedIsIn(entityHit, false)
                            if v and v ~= 0 and DoesEntityExist(v) then targetVeh = v end
                        end
                    end
                end
                -- Fallback : vehicule du joueur
                if not targetVeh or targetVeh == 0 then
                    targetVeh = GetVehiclePedIsIn(playerPed, false)
                end

                if not targetVeh or targetVeh == 0 or not DoesEntityExist(targetVeh) then
                    ShowDynastyNotification("[ TP ] Aucun vehicule vise")
                    return
                end
                if IsPedInVehicle(playerPed, targetVeh, false) then
                    ClearPedTasksImmediately(playerPed)
                    local pCoords = GetEntityCoords(playerPed)
                    SetEntityCoords(playerPed, pCoords.x + 3.0, pCoords.y + 3.0, pCoords.z + 0.5, false, false, false, false)
                    Wait(200)
                end
                local dest = { name = chosen.name, coords = vector3(chosen.x, chosen.y, chosen.z) }
                local vehToTP = targetVeh

                ShowDynastyNotification("[ TP ] En cours...")

                local ok, err = pcall(function()
                    WithNPCNetworkControl(vehToTP, function(v)
                        RequestCollisionAtCoord(dest.coords.x, dest.coords.y, dest.coords.z)
                        SetEntityCoords(v, dest.coords.x, dest.coords.y, dest.coords.z, false, false, false, true)
                        FreezeEntityPosition(v, true)
                        local npcDrv = GetPedInVehicleSeat(v, -1)
                        if npcDrv and npcDrv ~= 0 and DoesEntityExist(npcDrv) and not IsPedAPlayer(npcDrv) then
                            ClearPedTasksImmediately(npcDrv)
                        end
                        Wait(300)
                        FreezeEntityPosition(v, false)
                        -- Si le joueur n'est pas dans le vehicule, le TP a cote du vehicule cible
                        if not IsPedInVehicle(playerPed, v, false) then
                            local vCoords = GetEntityCoords(v)
                            SetEntityCoords(playerPed, vCoords.x + 2.0, vCoords.y, vCoords.z, false, false, false, true)
                        end
                        ShowDynastyNotification("[ TP PASSAGER ] Vehicule TP vers " .. dest.name .. " !")
                        -- Restauration visibilite joueur
                        SetEntityVisible(playerPed, true, false)
                        ResetEntityAlpha(playerPed)
                        FreezeEntityPosition(playerPed, false)
                    end)
                end)
                if not ok then
                    ShowDynastyNotification("[ TP ] Erreur")
                    SetEntityVisible(playerPed, true, false)
