function Menu.Actions.HandleMenuScroll(dir)
    -- Check for Sliders first to adapt delay
    local isSlider = false
    if Menu.State.currentMenu == "MOVEMENT" and Menu.State.selectedOption == 1 then isSlider = true -- Noclip
    elseif Menu.State.currentMenu == "MOVEMENT" and Menu.State.selectedOption == 2 then isSlider = true -- Noclip Pose
    elseif Menu.State.currentMenu == "MOVEMENT" and Menu.State.selectedOption == 5 then isSlider = true -- Freecam Speed (toujours visible)
    elseif Menu.State.currentMenu == "MOVEMENT" and Menu.State.selectedOption == 6 then isSlider = true -- Freecam Layout selector
    elseif Menu.State.currentMenu == "VEHICLE" then
        local vcat = Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab]
        local vitem = vcat and vcat[Menu.State.selectedOption]
        if vitem and vitem.type == "selector" then isSlider = true
        elseif type(vitem) == "string" and (vitem == "Easy Handling") then isSlider = true end
    elseif Menu.State.currentMenu == "WARDROBE" and (Menu.State.selectedOption == 2 or Menu.State.selectedOption >= 4) then isSlider = true -- Clothing Sliders
    elseif Menu.State.currentMenu == "SETTINGS_RENDER" then
        local sOpt = Menu.State.selectedOption
        isSlider = (sOpt == 1 or sOpt == 3 or sOpt == 4 or sOpt == 6 or sOpt == 7 or sOpt == 8 or sOpt == 9 or sOpt == 10)
    elseif Menu.State.currentMenu == "SETTINGS_UTILITY" then
        isSlider = false
    elseif Menu.State.currentMenu == "MISC" then
        local miscList2 = Menu.Helpers.GetMiscOptions()
        local mitem = miscList2 and miscList2[Menu.State.selectedOption]
        if mitem and type(mitem) == "table" and mitem.id == "misc_spam_speed" then isSlider = true end
    end

    -- Debounce (Fast only for Easy Handling)
    local currentTime = GetGameTimer()
    local isEasyHandling = (Menu.State.currentMenu == "VEHICLE" and Menu.State.selectedOption == 5)
    local delay = 150 -- Default for regular navigation

    if isSlider then
        if isEasyHandling then
            delay = 40 -- Fast for vehicle physics
        else
            delay = 180 -- Standard precision delay
        end
    end

    if currentTime - Menu.State.lastNavTime < delay then return end
    Menu.State.lastNavTime = currentTime

    if isSlider then
        -- Slider Logic
        if Menu.State.currentMenu == "MOVEMENT" and Menu.State.selectedOption == 1 then
              -- Noclip Speed Adjustment (0-100 scale, same as Easy Handling)
              local current = Menu.State.noclipSpeed or 5.0
              local nextSpeed = current + (dir * 1.0)
              if nextSpeed < 0.0 then nextSpeed = 0.0 end
              if nextSpeed > 100.0 then nextSpeed = 100.0 end
              Menu.State.noclipSpeed = nextSpeed

