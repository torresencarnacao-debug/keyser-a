            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
        elseif choice == "Utility" then
            Menu.State.currentMenu = "SETTINGS_UTILITY"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
        end

    elseif menu == "SETTINGS_RENDER" then
        local renderList = Menu.Helpers.GetSettingsRenderOptions()
        if index == 9 then
            -- Menu Border (index 9)
            Menu.State.menuBorderActive = not (Menu.State.menuBorderActive ~= false)
            ShowDynastyNotification("[ BORDURE ] " .. (Menu.State.menuBorderActive and "ON" or "OFF"))
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 10 then
            -- Freecam Crosshair (index 10)
            Menu.State.freecamCrosshairActive = not (Menu.State.freecamCrosshairActive ~= false)
            ShowDynastyNotification("Freecam Crosshair: " .. (Menu.State.freecamCrosshairActive and "ON" or "OFF"))
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 1 then
            _G.menuScale = math.min(1.3, (_G.menuScale or 1.0) + 0.1)
            Menu.Cache.lastResCheck = 0
        elseif index == 2 then
            _G.menuScale = 0.80
            Menu.Cache.lastResCheck = 0
        elseif index == 3 then
            Menu.State.menuPosIdx = ((Menu.State.menuPosIdx or 1) % 3) + 1
            local posNames = {"Gauche", "Centre", "Droite"}
            ShowDynastyNotification("[ POSITION ] " .. (posNames[Menu.State.menuPosIdx] or "Gauche"))
            Menu.Cache.lastResCheck = 0
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 4 then
            -- Banner Style: Enter = charge la texture
            local allowed = Menu.Helpers.GetAllowedBanners()
            local item = renderList[4]
            local idx = item and item.valueIdx or 1
            local bannerData = allowed[idx]
