                    break
                end
                targetPed = GetPlayerPed(newClientId)
                if not targetPed or not DoesEntityExist(targetPed) then
                    ShowDynastyNotification("[ HARD LAUNCH ] Cible perdue")
                    break
                end

                -- VÃ©rif range : si le joueur est trop loin, on s'arrÃªte
                local myPos = GetEntityCoords(myPed)
                local targetPos = GetEntityCoords(targetPed)
                local dist = #(targetPos - myPos)

                if dist > HARD_LAUNCH_MAX_RANGE then
                    ShowDynastyNotification("[ HARD LAUNCH ] Hors range (" .. math.floor(dist) .. "m)")
                    Menu.State.hardLaunchActive = false
                    break
                end

                -- Une passe de Launch V1 (attach/detach x10 identique a LaunchPlayer)
                local angle = math.random() * 2 * math.pi
