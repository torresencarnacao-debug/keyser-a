local function ESP_GetVColors()
    local tc,bc,sc,lc = 1,1,1,1
    local vl = Menu.Data.Options.Visual.Categories[2] or {}
    if vl then
        for _,item in ipairs(vl) do
            if type(item)=="table" and item.type=="selector" then
                local id = item.id or ""
                if id=="esp_textcolor" then tc = item.valueIdx or 1
                elseif id=="esp_boxcolor"  then bc = item.valueIdx or 1
                elseif id=="esp_skelcolor" then sc = item.valueIdx or 1
                elseif id=="esp_linecolor" then lc = item.valueIdx or 1
                end
            end
        end
    end
    -- RÃ©solution RGB dynamique : index 8 = rainbow cycling
    local function resolveColor(idx)
        if idx == 8 then
            local rr, rg, rb = HSVtoRGB(_G.espRgbHue or 0, 1.0, 1.0)
            return {rr/255, rg/255, rb/255}
        end
        return ESP_Colors[idx] or ESP_Colors[1]
    end
    return resolveColor(tc), resolveColor(bc), resolveColor(sc), resolveColor(lc)
end

local function ESP_HealthColor(pct)
    if pct > 0.5 then
        local t = (pct - 0.5) * 2
        return 1-t, 1, 0, 1
    else
        local t = pct * 2
        return 1, t, 0, 1
    end
end

local function ESP_RenderPed(targetPed, playerIdx, sw, sh, myPos, s)
    if not DoesEntityExist(targetPed) then return end
    local targetPos = GetEntityCoords(targetPed, false)
    local dist = #(myPos - targetPos)
    if dist > (s.maxDist or 500.0) then return end

    local onScreen, sx, sy = GetScreenCoordFromWorldCoord(targetPos.x, targetPos.y, targetPos.z)
    if not onScreen then return end

    -- Coordonnées tête (os SKEL_Head) et pieds précis
    local headPos = GetPedBoneCoords(targetPed, 31086, 0, 0, 0)
    if headPos.x == 0 and headPos.y == 0 then headPos = targetPos end

    local okH, hX, hY = GetScreenCoordFromWorldCoord(headPos.x, headPos.y, headPos.z + 0.12)
    local okF, fX, fY = GetScreenCoordFromWorldCoord(targetPos.x, targetPos.y, targetPos.z - 1.0)
    if not okH or not okF or not hX or not hY or not fX or not fY then return end
    if hX < -0.1 or hX > 1.1 or hY < -0.1 or hY > 1.1 then return end

    local height = math.abs(fY - hY)
    if height < 0.004 then return end
    local width = height * 0.38

    local cx_norm = (hX + fX) * 0.5
    local bx1 = cx_norm - width * 0.5
    local bx2 = cx_norm + width * 0.5
    local by1 = math.min(hY, fY)
    local by2 = math.max(hY, fY)

    -- Squelette : Simple = lignes basiques, Complet = lignes epaisses + dots aux articulations
    if s.drawSkeleton then
        local boneCache = {}
        local dotSet = {}
        for _, link in ipairs(ESP_SkeletonLinks) do
            local b1, b2 = link[1], link[2]
            if not boneCache[b1] then boneCache[b1] = GetPedBoneCoords(targetPed, b1, 0,0,0) end
            if not boneCache[b2] then boneCache[b2] = GetPedBoneCoords(targetPed, b2, 0,0,0) end
            local p1, p2 = boneCache[b1], boneCache[b2]
            local os1,x1s,y1s = GetScreenCoordFromWorldCoord(p1.x,p1.y,p1.z)
            local os2,x2s,y2s = GetScreenCoordFromWorldCoord(p2.x,p2.y,p2.z)
            if os1 and os2 and x1s>=0 and x1s<=1 and y1s>=0 and y1s<=1
                and x2s>=0 and x2s<=1 and y2s>=0 and y2s<=1 and Keyser and Keyser.DrawLine then
                local sx1p, sy1p = x1s*sw, y1s*sh
                local sx2p, sy2p = x2s*sw, y2s*sh
                if s.espMode == 2 then
                    -- Simple : ombre fine + ligne couleur simple
                    Keyser.DrawLine(sx1p,sy1p, sx2p,sy2p, 0,0,0,1,2)
                    Keyser.DrawLine(sx1p,sy1p, sx2p,sy2p, s.skelColor[1],s.skelColor[2],s.skelColor[3],1,1)
                else
                    -- Complet : ombre epaisse + ligne couleur + dots
                    Keyser.DrawLine(sx1p,sy1p, sx2p,sy2p, 0,0,0,1,3)
                    Keyser.DrawLine(sx1p,sy1p, sx2p,sy2p, s.skelColor[1],s.skelColor[2],s.skelColor[3],1,1.5)
                    dotSet[b1] = {sx1p, sy1p}
                    dotSet[b2] = {sx2p, sy2p}
                end
            end
        end
        -- Dots aux articulations (mode Complet uniquement)
        if s.espMode ~= 2 and Keyser and Keyser.DrawRectFilled then
            for _, pt in pairs(dotSet) do
                local px, py = pt[1], pt[2]
                Keyser.DrawRectFilled(px-3, py-3, 6, 6, 0,0,0,1,10)
                Keyser.DrawRectFilled(px-1.5, py-1.5, 3, 3, s.skelColor[1],s.skelColor[2],s.skelColor[3],1,10)
            end
        end
    end

    -- Boite : Simple = box pleine classique, Complet = corner box stylisee
    if s.drawBox then
        if s.espMode == 2 then
            -- Mode Simple : box 4 cotes complete
            if Keyser and Keyser.DrawLine then
                local px1, py1 = bx1 * sw, by1 * sh
                local px2, py2 = bx2 * sw, by2 * sh
                Keyser.DrawLine(px1-1, py1-1, px2+1, py1-1, 0,0,0,1,1)
                Keyser.DrawLine(px1-1, py2+1, px2+1, py2+1, 0,0,0,1,1)
                Keyser.DrawLine(px1-1, py1-1, px1-1, py2+1, 0,0,0,1,1)
                Keyser.DrawLine(px2+1, py1-1, px2+1, py2+1, 0,0,0,1,1)
                Keyser.DrawLine(px1, py1, px2, py1, s.boxColor[1],s.boxColor[2],s.boxColor[3],1,1)
                Keyser.DrawLine(px1, py2, px2, py2, s.boxColor[1],s.boxColor[2],s.boxColor[3],1,1)
                Keyser.DrawLine(px1, py1, px1, py2, s.boxColor[1],s.boxColor[2],s.boxColor[3],1,1)
                Keyser.DrawLine(px2, py1, px2, py2, s.boxColor[1],s.boxColor[2],s.boxColor[3],1,1)
            end
        else
            -- Mode Complet : corner box (seulement les extremites)
            ESP_DrawCornerBox(bx1, by1, bx2, by2, s.boxColor[1], s.boxColor[2], s.boxColor[3], 1, sw, sh)
        end
    end

    -- Tracer : Simple = ligne droite, Complet = ligne + fleche (pointe vers le joueur)
    if s.drawLine and Keyser and Keyser.DrawLine then
        local lox, loy = sw * 0.5, sh
        local lo = s.lineOrigin or 1
        if lo == 2 then lox = 0
        elseif lo == 3 then lox = sw
        end
        local tx, ty = sx * sw, sy * sh
        -- Ligne principale (ombre + couleur)
        Keyser.DrawLine(lox, loy, tx, ty, 0,0,0,1,2)
        Keyser.DrawLine(lox, loy, tx, ty, s.lineColor[1],s.lineColor[2],s.lineColor[3],0.9,1)
        -- Mode Complet uniquement : pointe de fleche
        if s.espMode ~= 2 then
            local dx = tx - lox
            local dy = ty - loy
            local len = math.sqrt(dx*dx + dy*dy)
            if len > 20 then
                local nx, ny = dx/len, dy/len
                local arrLen, arrW = 14, 7
                local ax = tx - nx * arrLen
                local ay = ty - ny * arrLen
                local px_off, py_off = -ny * arrW, nx * arrW
                Keyser.DrawLine(tx, ty, ax + px_off, ay + py_off, 0,0,0,1,2)
                Keyser.DrawLine(tx, ty, ax - px_off, ay - py_off, 0,0,0,1,2)
                Keyser.DrawLine(tx, ty, ax + px_off, ay + py_off, s.lineColor[1],s.lineColor[2],s.lineColor[3],0.9,1)
                Keyser.DrawLine(tx, ty, ax - px_off, ay - py_off, s.lineColor[1],s.lineColor[2],s.lineColor[3],0.9,1)
            end
        end
    end

    -- Barre santÃ© (gauche, couleur dÃ©gradÃ©e vertâ†’rouge)
    if s.drawHealth then
        local hp    = GetEntityHealth(targetPed)
        local maxHp = GetEntityMaxHealth(targetPed)
        local pct   = math.max(0, math.min(1, (hp - 100) / math.max(1, maxHp - 100)))
        local barH  = (by2 - by1) * sh
        if barH > 0 then
            local barX = bx1 * sw - 5
            local barY = by1 * sh
            ESP_FillRect(barX - 1, barY - 1, 4, barH + 2, 0,0,0,1)
            local hr, hg, hb, ha = ESP_HealthColor(pct)
            ESP_FillRect(barX, barY + barH*(1-pct), 2, barH*pct, hr,hg,hb,ha)
        end
    end

    -- Barre armure (bleu, juste Ã  gauche de la santÃ©)
    if s.drawArmor then
        local armor = math.max(0, math.min(1, GetPedArmour(targetPed) / 100))
        if armor > 0 then
            local barH  = (by2 - by1) * sh
            local offset = s.drawHealth and 9 or 5
            local barX  = bx1 * sw - offset
            local barY  = by1 * sh
            if barH > 0 then
                ESP_FillRect(barX - 1, barY - 1, 4, barH + 2, 0,0,0,1)
                ESP_FillRect(barX, barY + barH*(1-armor), 2, barH*armor, 0,0.5,1,1)
            end
        end
    end

    -- Textes (nom en haut, reste en bas)
    local topLines, botLines = {}, {}
    if s.drawName then table.insert(topLines, GetPlayerName(playerIdx)) end
    if s.drawID   then table.insert(topLines, "ID:" .. tostring(GetPlayerServerId(playerIdx))) end
    if s.drawDist then table.insert(botLines, math.floor(dist) .. "m") end
    if s.drawWeapon then
        local _, wHash = GetCurrentPedWeapon(targetPed, true)
        table.insert(botLines, ESP_GetWeaponDisplay(wHash, s.weaponDisplay or 1))
    end

    local cx  = cx_norm * sw
    local fsz = math.max(9, math.min(14, height * sh * 0.18)) * (s.textSizeMult or 1.0)
    local gap = fsz + 2
    for i, txt in ipairs(topLines) do
        local tw = (Keyser and Keyser.GetTextWidth) and Keyser.GetTextWidth(txt, fsz) or 0
        ESP_TextOutline(cx - tw * 0.5, by1 * sh - gap * i, txt, fsz, s.textColor[1], s.textColor[2], s.textColor[3])
    end
    for i, txt in ipairs(botLines) do
        local tw = (Keyser and Keyser.GetTextWidth) and Keyser.GetTextWidth(txt, fsz) or 0
        ESP_TextOutline(cx - tw * 0.5, by2 * sh + 3 + gap * (i - 1), txt, fsz, s.textColor[1], s.textColor[2], s.textColor[3])
    end
end

