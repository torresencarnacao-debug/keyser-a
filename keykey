function Menu.Helpers.DrawHollowBorderRect(x, y, w, h, r, g, b, a, bgA, radius)
    if not Keyser or not Keyser.DrawRectFilled then return end
    local rad   = radius or 6.0
    local thick = 1.0
    local borderAlpha = a or 0.75
    Keyser.DrawRectFilled(x - thick, y - thick, w + thick * 2, h + thick * 2, r, g, b, borderAlpha, rad + thick)
    -- Fond interieur : Noir pur 100% opaque (0 reflet)
    Keyser.DrawRectFilled(x, y, w, h, 0.0, 0.0, 0.0, 1.0, rad)
