            local dests = _G.TpPassengerDestinations
            local destLabel = (dests and dests[di]) and dests[di].name or "Ocean"
            text = text .. " [" .. destLabel .. "]"
        elseif text == "Bug Vehicle" then
            text = "Launch Vehicle  [" .. (Menu.State.bugVehicleForce or 50) .. "]"
        elseif text == "Physgun" then
            local PS = _G.PhysgunState
            if PS and PS.active then
                text = "Physgun  [SAISI] " .. math.floor(PS.distance) .. "m"
            else
                text = "Physgun"
                -- Afficher le hint uniquement quand cette option est sélectionnée (slot == 1)
                if isSelected then
                    if not _G._physgunHintShown then
                        ShowDynastyNotification("[ PHYSGUN ] Clic droit=Saisir  Clic gauche=Lancer")
                        _G._physgunHintShown = true
                    end
                else
                    _G._physgunHintShown = false
                end
            end
        end

        local textX = cx - 80.0 * menuSc
        local textW = 160.0 * menuSc
        if type(Keyser.GetTextWidth) == "function" then
            textW = Keyser.GetTextWidth(text, size)
            textX = cx - textW / 2.0
        end

        -- Effet BOLD (Gras 4 directions) + Ombre portée pour l'option sélectionnée
        if isSelected then
            local off = 1.2 * menuSc
            Keyser.DrawText(textX - off, y, text, size, 0.0, 0.0, 0.0, 0.95)
            Keyser.DrawText(textX + off, y, text, size, 0.0, 0.0, 0.0, 0.95)
            Keyser.DrawText(textX, y - off, text, size, 0.0, 0.0, 0.0, 0.95)
            Keyser.DrawText(textX, y + off, text, size, 0.0, 0.0, 0.0, 0.95)
            Keyser.DrawText(textX + 2.0, y + 2.0, text, size, 0.0, 0.0, 0.0, 0.95)
        end

        -- Texte : sélectionné = très grand/GRAS + couleur thème, non sélectionné = discret + gris
        local fR = isSelected and tr  or rNorm
        local fG = isSelected and tg  or gNorm
        local fB = isSelected and tb  or bNorm
        local fA = isSelected and 1.0 or 0.55
        Keyser.DrawText(textX, y, text, size, fR, fG, fB, fA)
    end
    Keyser.SubmitFrame()
end

function UpdateFreecam()
    if not freecam_active then return end

    local forward = 0.0
    local sideways = 0.0
    local vertical = 0.0

    if type(Keyser.GetAsyncKeyState) == "function" then
        local _layout = FREECAM_LAYOUTS[_G.freecam_layout or 1] or FREECAM_LAYOUTS[1]
        if Keyser.GetAsyncKeyState(_layout.fwd)   then forward  =  1.0 end
        if Keyser.GetAsyncKeyState(_layout.back)  then forward  = -1.0 end
        if Keyser.GetAsyncKeyState(_layout.right) then sideways =  1.0 end
        if Keyser.GetAsyncKeyState(_layout.left)  then sideways = -1.0 end
        if Keyser.GetAsyncKeyState(VK_SPACE)   then vertical =  1.0 end
        if Keyser.GetAsyncKeyState(VK_CONTROL) then vertical = -1.0 end

        -- Mouse Wheel Elevation handled by HandleInputMenu for menu navigation only

        local speed = normal_speed
        if Keyser.GetAsyncKeyState(VK_SHIFT) then
            speed = fast_speed
        end

        local curPed = PlayerPedId()
        local isDead = false
        if DoesEntityExist(curPed) and (IsPedDeadOrDying(curPed, true) or IsEntityDead(curPed) or GetEntityHealth(curPed) <= 0) then
            isDead = true
        end

        if not isDead then
            -- En vie : récupération fluide de la rotation native de gameplay
            local currentRot = GetGameplayCamRot(2)
            cam_rot = vector3(currentRot.x, currentRot.y, currentRot.z)
        else
            -- Quand mort / coma : lecture multi-groupes de la souris pour rotation totale 360°
            if not Menu.State.menuOpen and not _G.isBindingNoclip and not IsBlockingUIActive() then
                local dx = GetDisabledControlNormal(0, 1)
                if dx == 0.0 then dx = GetDisabledControlNormal(1, 1) end
                if dx == 0.0 then dx = GetDisabledControlNormal(2, 1) end
                if dx == 0.0 then dx = GetControlNormal(0, 1) end
                if dx == 0.0 then dx = GetControlNormal(2, 1) end

                local dy = GetDisabledControlNormal(0, 2)
                if dy == 0.0 then dy = GetDisabledControlNormal(1, 2) end
                if dy == 0.0 then dy = GetDisabledControlNormal(2, 2) end
                if dy == 0.0 then dy = GetControlNormal(0, 2) end
                if dy == 0.0 then dy = GetControlNormal(2, 2) end

                local mouseSens = 6.0
                local curP = cam_rot.x or 0.0
                local curY = cam_rot.z or 0.0
                local newPitch = math.max(-89.0, math.min(89.0, curP - (dy * mouseSens)))
                local newYaw   = (curY - (dx * mouseSens)) % 360.0
                cam_rot = vector3(newPitch, 0.0, newYaw)
            end
        end

        local rad_pitch = math.rad(cam_rot.x)
        local rad_yaw = math.rad(cam_rot.z)

        local fwdX = -math.sin(rad_yaw) * math.cos(rad_pitch)
        local fwdY =  math.cos(rad_yaw) * math.cos(rad_pitch)
        local fwdZ =  math.sin(rad_pitch)

        local rightX =  math.cos(rad_yaw)
        local rightY =  math.sin(rad_yaw)

        cam_pos = vector3(
            cam_pos.x + (forward * fwdX + sideways * rightX) * speed,
            cam_pos.y + (forward * fwdY + sideways * rightY) * speed,
            cam_pos.z + (forward * fwdZ + vertical) * speed
        )

        ForceWorldLoad()
        if type(Keyser.SetCameraPos) == "function" then
            Keyser.SetCameraPos(cam_pos.x, cam_pos.y, cam_pos.z)
        end
        if _freecam_fov_cam and _freecam_fov_cam ~= 0 and DoesCamExist(_freecam_fov_cam) then
            SetCamCoord(_freecam_fov_cam, cam_pos.x, cam_pos.y, cam_pos.z)
            SetCamRot(_freecam_fov_cam, cam_rot.x, cam_rot.y, cam_rot.z, 2)
            SetCamFov(_freecam_fov_cam, Menu.State.freecamFov or 100.0)
            SetCamActive(_freecam_fov_cam, true)
            RenderScriptCams(true, false, 0, true, true)
        end

        -- Synchroniser dans Menu.State.Freecam pour que GetShootSource soit toujours à jour
        _G.Menu.State.Freecam.pos    = cam_pos
        _G.Menu.State.Freecam.rot    = cam_rot
        _G.Menu.State.Freecam.active = freecam_active
    end
end

