                ShowDynastyNotification("[ DASHBOARD ] Banniere & Couleur actualisees depuis localhost !")
            end
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end

    elseif menu == "SETTINGS_UTILITY" then
        if index == 1 then
            Menu.State.currentMenu = "CONFIGS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 2 then
            Menu.State.currentMenu = "ACTIVE_BINDS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 3 then
            -- Toggle HUD Binds (coin d'écran)
            Menu.State.hudBindsVisible = not Menu.State.hudBindsVisible
            local state = Menu.State.hudBindsVisible and "ON" or "OFF"
            ShowDynastyNotification("[ HUD BINDS ] " .. state)
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 4 then
            -- Toggle Spectator List HUD
            Menu.State.spectatorListVisible = not Menu.State.spectatorListVisible
            local state = Menu.State.spectatorListVisible and "ON" or "OFF"
            ShowDynastyNotification("[ SPECTATOR LIST ] " .. state)
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end

    elseif menu == "ACTIVE_BINDS" then
        local options = Menu.Helpers.GetActiveBindsOptions()
        local item = options[index]
        if item and item.id == "active_bind_action" then
            local selectorIdx = (_G.ActiveBindSelectorState and _G.ActiveBindSelectorState[item.bindKey]) or 1
            if selectorIdx == 1 then
                -- Modifier : ouvrir l'overlay de rebinding
                _G.bindingActionData = {
                    menu  = item.bindData.menu,
                    index = item.bindData.index,
                    label = item.bindData.label,
                    type  = "DYNAMIC",
                    replaceKey = item.bindKey
                }
                _G.bindingText = "Nouveau bind pour : " .. (item.bindData.label or "?")
                _G.bindingKeyDisplay = ""
                _G.bindingVK = 0
                _G.isBindingNoclip = true
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            elseif selectorIdx == 2 then
                -- Supprimer
                local removedLabel = item.bindData.label or "?"
                _G.UniversalKeyBinds[item.bindKey] = nil
                if _G.ActiveBindSelectorState then _G.ActiveBindSelectorState[item.bindKey] = nil end
                ShowDynastyNotification("[ BIND ] " .. removedLabel .. " supprime")
                Menu.State.selectedOption = math.max(1, index - 1)
                PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            end
        end

    elseif menu == "KEYBINDS" then
        local options = Menu.Helpers.GetKeybindOptions()
        local item = options[index]
        if item and item.id == "bind_action" then
            -- Lire l'état depuis le cache persistent
            local selectorIdx = (_G.KeybindSelectorState and _G.KeybindSelectorState[item.bindKey]) or 1
            if selectorIdx == 1 then
                -- Changer : ouvrir l'overlay de binding
                _G.bindingActionData = {
                    menu = item.bindData.menu,
                    index = item.bindData.index,
                    label = item.bindData.label,
                    type = "DYNAMIC",
                    replaceKey = item.bindKey
                }
                _G.bindingText = "Nouveau bind pour : " .. (item.bindData.label or "?")
                _G.bindingKeyDisplay = ""
                _G.bindingVK = 0
                _G.isBindingNoclip = true
                PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
            elseif selectorIdx == 2 then
                -- Supprimer
                local removedLabel = item.bindData.label or "?"
                _G.UniversalKeyBinds[item.bindKey] = nil
                -- Nettoyer le cache pour cette touche
                if _G.KeybindSelectorState then _G.KeybindSelectorState[item.bindKey] = nil end
                ShowDynastyNotification("[ BIND ] " .. removedLabel .. " supprime")
                PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
                Menu.State.selectedOption = math.max(1, index - 1)
            end
        end

    elseif menu == "CONFIGS" then
        local configsList = Menu.Helpers.GetConfigsOptions()
        local choice = configsList[index]
        if choice == "Create new config..." then
            Citizen.CreateThread(function()
                local name = Menu.Helpers.PromptKeyboardInput("Nom de la config", "", 20)
                if name and name ~= "" then
                    name = name:gsub("[^a-zA-Z0-9_%-%s]", "")
                    if name ~= "" then
                        -- Verifier si le nom existe deja
                        local alreadyExists = Menu.CloudConfigs and Menu.CloudConfigs.profiles and Menu.CloudConfigs.profiles[name]
                        if alreadyExists then
                            local overwrite = Menu.Helpers.PromptConfirm("Config \"" .. name .. "\" existe deja ! Remplacer ?")
                            if not overwrite then
                                ShowDynastyNotification("[ CONFIG ] Annule")
                                return
                            end
                        end
                        Menu.Helpers.SaveConfigProfile(name)
                        Menu.State.selectedOption = 1
                        Menu.State.startIndex = 1
                    else
                        ShowDynastyNotification("[ CONFIG ] Nom invalide")
                    end
                else
                    ShowDynastyNotification("[ CONFIG ] Annule")
                end
            end)
        elseif type(choice) == "string" then
            Menu.State.selectedProfileName = choice
            Menu.State.currentMenu = "CONFIG_OPTIONS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end

    elseif menu == "CONFIG_OPTIONS" then
        local name = Menu.State.selectedProfileName
        if index == 1 then
            if name then
                Menu.Helpers.LoadConfigProfile(name)
            end
            Menu.State.currentMenu = "CONFIGS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 2 then
            if name then
                Menu.Helpers.DeleteConfigProfile(name)
            end
            Menu.State.currentMenu = "CONFIGS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "SELECT", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        elseif index == 3 then
            Menu.State.currentMenu = "CONFIGS"
            Menu.State.selectedOption, Menu.State.startIndex = 1, 1
            PlaySoundFrontend(-1, "BACK", "HUD_FRONTEND_DEFAULT_SOUNDSET", true)
        end
    end
end

function Menu.Actions.HandleMenuSelection()
    local currentTime = GetGameTimer()
    if (currentTime - (Menu.State.lastSelectTime or 0)) < 250 then return end

    -- Robust Anti-Trigger Link: 500ms lock after category switch
    if (currentTime - (Menu.State.menuLastSwitchTime or 0)) < 500 then return end

    Menu.State.lastSelectTime = currentTime
    lastMenuOpenPress = currentTime

    Citizen.CreateThread(function()
        local ok, errorMsg = pcall(function()
            ExecuteMenuAction(Menu.State.currentMenu, Menu.State.selectedOption)
        end)
        if not ok then
            ShowDynastyNotification("[ ERREUR ] " .. tostring(errorMsg or "Erreur inconnue"))
        end
    end)
end

function Menu.Actions.HandleBackNavigation()
    if Menu.State.currentMenu == "SETTINGS" then
        Menu.State.currentMenu = "MAIN"
        Menu.State.mainTab = 1
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "MOVEMENT" or Menu.State.currentMenu == "WARDROBE" then
        -- Sous-tabs de PLAYER : retour vers PLAYER, pas MAIN
        Menu.State.currentMenu = "PLAYER"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "PROPS" then
        -- Sous-menu PROPS : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "COL_SCENARIO" then
        -- Sous-menu COL_SCENARIO : retour vers VIP (plus utilise en temps normal)
        Menu.State.currentMenu = "VIP"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "TP_PASSAGER" then
        -- Sous-menu TP_PASSAGER : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "DYNA" then
        -- Sous-menu DYNA : retour vers MISC
        Menu.State.currentMenu = "MISC"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif _vipGiveCatKey and _vipGiveCatKey[Menu.State.currentMenu] then
        Menu.State.currentMenu = "VIP_GIVE"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "VIP_PED" or Menu.State.currentMenu == "VIP_GIVE" or Menu.State.currentMenu == "VIP_RESOURCE" then
        Menu.State.currentMenu = "EXPLOIT"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "SETTINGS_RENDER" or Menu.State.currentMenu == "SETTINGS_UTILITY" then
        Menu.State.currentMenu = "SETTINGS"
        Menu.State.selectedOption, Menu.State.startIndex = 1, 1
    elseif Menu.State.currentMenu == "EXPLOIT" or Menu.State.currentMenu == "VIP" then
        Menu.State.currentMenu = "MAIN"
        Menu.State.mainTab = 1
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "CONFIGS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "KEYBINDS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "ACTIVE_BINDS" then
        Menu.State.currentMenu = "SETTINGS_UTILITY"
        Menu.State.selectedOption = 2
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu == "CONFIG_OPTIONS" then
        Menu.State.currentMenu = "CONFIGS"
        Menu.State.selectedOption = 1
        Menu.State.startIndex = 1
    elseif Menu.State.currentMenu ~= "MAIN" then
        if Menu.State.currentMenu == "ONLINE" then
            Menu.State.onlineRestoreOption = Menu.State.selectedOption
            Menu.State.onlineRestoreStart = Menu.State.startIndex
        end
        Menu.State.currentMenu = "MAIN"
        Menu.State.selectedOption = Menu.State.mainRestoreOption or 1
        Menu.State.startIndex = 1
    else
        -- Sur MAIN, la touche retour (Backspace) ne ferme PAS le menu.
        -- Le menu se ferme uniquement avec la touche d'ouverture/fermeture.
        return
    end
end

