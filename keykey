                        local bta = 0.8
                        local br, bg, bb, a_bg2 = btr, btg, btb, bta * 0.4
                        if badgeOverride == "ACTIVE" then a_bg2 = bta end
                        Keyser.DrawRectFilled(badgeX, switchY, badgeW, switchH, br, bg, bb, a_bg2, 10)
                        if Keyser.GetTextWidth then
