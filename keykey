            -- Actualiser Banniere Perso
            local curB = nil
            for gi, b in ipairs(Menu.AvailableBanners) do
                if b.name == "Perso" then curB = b; Menu.BannerIndex = gi; break end
            end
            if curB and Menu.LoadBannerTexture then
                Menu.LoadBannerTexture(curB.url, true)
