function StopFreecam()
    local ped = PlayerPedId()
    if type(Keyser.LockCameraPos) == "function" then
        Keyser.LockCameraPos(false)
    end
    if not IsPedInAnyVehicle(ped, false) then
        FreezeEntityPosition(ped, false)
    end

    -- Desactiver le godmode freecam uniquement si c'est nous qui l'avions active
    -- (si un godmode du menu etait deja actif avant, on ne touche a rien)
    if not _G._freecamHadGodmode then
        if type(Keyser) == "table" and type(Keyser.InjectResource) == "function" then
            Keyser.InjectResource("any", [[
                _G.FullGodmodeEnabled = false
            ]])
        end
        if DoesEntityExist(ped) then
            SetEntityInvincible(ped, false)
            if SetPlayerInvincible then SetPlayerInvincible(PlayerId(), false) end
            SetEntityProofs(ped, false, false, false, false, false, false, false, false)
            SetEntityCanBeDamaged(ped, true)
        end
        if _G._freecamAntiHS then
            if DoesEntityExist(ped) then
                SetPedSuffersCriticalHits(ped, true)
                SetPedCanRagdoll(ped, true)
                SetPedCanRagdollFromPlayerImpact(ped, true)
            end
            _G._freecamAntiHS = false
        end
    end
    _G._freecamHadGodmode = nil

    ClearFocus()
    if _freecam_fov_cam and _freecam_fov_cam ~= 0 and DoesCamExist(_freecam_fov_cam) then
        SetCamActive(_freecam_fov_cam, false)
        RenderScriptCams(false, false, 0, true, true)
        DestroyCam(_freecam_fov_cam, false)
    end
    _freecam_fov_cam = nil
    freecam_active = false
    _G.freecam_active = false
    shootVisionActive = false  -- Reset du Shoot Vision freecam  la sortie
    -- Nettoyer le Physgun si actif
    PhysgunRelease()
end

