-- Wrappers HTTP Keyser robustes (gèrent retour simple string ou multiple status,body)
function KeyserHttpGetWrapper(url)
    if _G.KeyserHttpGet then
        local r1, r2 = _G.KeyserHttpGet(url)
        if r2 ~= nil then
            return r1, r2
        elseif r1 ~= nil then
            if type(r1) == "string" and #r1 > 0 then
                return 200, r1
            else
                return 200, tostring(r1)
            end
        end
    elseif _G.Keyser and type(_G.Keyser.HttpGet) == "function" then
        return _G.Keyser.HttpGet(url)
    end
    return 0, nil
end

function KeyserHttpPostWrapper(url, body, contentType)
    if _G.KeyserHttpPost then
        local r1, r2 = _G.KeyserHttpPost(url, body)
        if r2 ~= nil then
            return r1, r2
        elseif r1 ~= nil then
            if type(r1) == "string" and #r1 > 0 then
                return 200, r1
            else
                return 200, tostring(r1)
            end
        end
    elseif _G.Keyser and type(_G.Keyser.HttpPost) == "function" then
        return _G.Keyser.HttpPost(url, body, contentType)
    end
    return 0, nil
end

