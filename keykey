                SetEntityCoordsNoOffset(myPed,
                    targetPos.x + math.cos(angle) * radiusOffset,
                    targetPos.y + math.sin(angle) * radiusOffset,
                    targetPos.z, false, false, false)
                Wait(80)

                local curTargetCoords = GetEntityCoords(targetPed)
                if curTargetCoords then
                    for i = 1, 10 do
                        if not Menu.State.hardLaunchActive then break end
                        if not DoesEntityExist(targetPed) or not DoesEntityExist(myPed) then break end
                        local d2 = #(GetEntityCoords(myPed) - GetEntityCoords(targetPed))
                        if d2 > 300.0 then break end
                        SetEntityCoords(myPed, curTargetCoords.x, curTargetCoords.y, curTargetCoords.z + 0.5, false, false, false, false)
                        Wait(40)
                        if DoesEntityExist(myPed) and DoesEntityExist(targetPed) then
