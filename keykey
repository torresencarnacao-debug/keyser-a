        return
    end

    -- Cycle : 1=Invisible -> 2=Visible -> 3=Aladin -> 4=OmniMove -> 1
    local pose = ((Menu.State.noclipPose or 1) % 4) + 1
    Menu.State.noclipPose = pose

    local ped = PlayerPedId()

    -- Stopper toutes les anims de poses precedentes AVANT d'en lancer une nouvelle
    ClearPedTasks(ped)
    SetPedCanPlayGestureAnims(ped, true)
    StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
    StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
    Wait(80)

    -- Visibilite : OmniMove toujours visible (on doit voir le perso pointer)
    local isInvisible = (pose == 1) and not Menu.State.bypassSeedActive
    Menu.State.noclipInvisible = isInvisible
    SetEntityVisible(ped, not isInvisible, false)
    local veh = GetVehiclePedIsIn(ped, false)
    if veh and veh ~= 0 then SetEntityVisible(veh, not isInvisible, false) end

    -- Animation selon la pose
    if pose == 3 then
        -- ALADIN : pose tailleur figee (freeze frame 0)
        local dict = "rcmcollect_paperleadinout@"
        RequestAnimDict(dict)
        local t = GetGameTimer()
        while not HasAnimDictLoaded(dict) and (GetGameTimer() - t) < 3000 do Wait(10) end
        if HasAnimDictLoaded(dict) then
            TaskPlayAnim(ped, dict, "meditiate_idle", 8.0, -8.0, -1, 1, 0.0, false, false, false)
            SetEntityAnimSpeed(ped, dict, "meditiate_idle", 0.0)
            SetEntityAnimCurrentTime(ped, dict, "meditiate_idle", 0.0)
        end
        ShowDynastyNotification("[ NOCLIP ] Pose: Aladdin (Cross-legged)")

    elseif pose == 4 then
        -- OMNI MOVE : le ped s'oriente en temps reel vers la camera (pitch + yaw complets)
        ShowDynastyNotification("[ NOCLIP ] Pose: Omni Move (Camera Direction)")

    else
        -- Visible ou Invisible : tout nettoyer
        if pose == 1 then
            ShowDynastyNotification("[ NOCLIP ] Pose : Invisible")
        else
            ShowDynastyNotification("[ NOCLIP ] Pose : Visible")
        end
    end
end

function Menu.Actions.ToggleNoclip()
    if not _G.AuthDone then return end
    Menu.State.noclipActive = not Menu.State.noclipActive

    if Menu.State.noclipActive then
        -- Pose par defaut au demarrage
        if not Menu.State.noclipPose then Menu.State.noclipPose = 2 end
        local isInvisible = (Menu.State.noclipPose == 1) and not Menu.State.bypassSeedActive
        Menu.State.noclipInvisible = isInvisible

        local ped = PlayerPedId()
        SetEntityVisible(ped, not isInvisible, false)
        local veh0 = GetVehiclePedIsIn(ped, false)
        if veh0 and veh0 ~= 0 then SetEntityVisible(veh0, not isInvisible, false) end

        Citizen.CreateThread(function()
            local currentSpeed = (Menu.State.noclipSpeed or 5.0) / 5.0
            local lastVeh = 0
            local lastVehForCam = 0
            local poseAnimActive = false

            -- Dictionnaires anim precharges
            local dictAladin = "rcmcollect_paperleadinout@"
            RequestAnimDict(dictAladin)

            -- Thread separe pour maintenir la pose et l'OmniMove
            local _lastOmniPose = false -- tracker pour reset alpha quand on quitte pose 4
            Citizen.CreateThread(function()
                while Menu.State.noclipActive do
                    local ped = PlayerPedId()
                    if not ped or ped == 0 then Citizen.Wait(100)
                    else
                    local pose = Menu.State.noclipPose or 1
                    local veh = GetVehiclePedIsIn(ped, false)
                    local inVehicle = (veh and veh ~= 0)

                    if not inVehicle then
                        local isShooting = IsPedShooting(ped) or IsDisabledControlPressed(0, 24)

                        if pose == 3 then
                            -- ALADIN : maintien de la pose tailleur
                            -- Quitter OmniMove : reset alpha si on venait de pose 4
                            if _lastOmniPose then
                                ResetEntityAlpha(ped)
                                _lastOmniPose = false
                            end
                            SetPedCanPlayGestureAnims(ped, true)
                            if HasAnimDictLoaded(dictAladin) and not isShooting then
                                if not IsEntityPlayingAnim(ped, dictAladin, "meditiate_idle", 3) then
                                    TaskPlayAnim(ped, dictAladin, "meditiate_idle", 8.0, -8.0, -1, 1, 0.0, false, false, false)
                                end
                                SetEntityAnimSpeed(ped, dictAladin, "meditiate_idle", 0.0)
                                SetEntityAnimCurrentTime(ped, dictAladin, "meditiate_idle", 0.0)
                            end

                        elseif pose == 4 then
                            -- OMNI MOVE : orientation complete vers la camera + translucide LOCAL uniquement
                            -- false = client-side only, les autres joueurs voient le ped opaque normalement
                            SetEntityVisible(ped, true, false)
                            SetEntityAlpha(ped, 120, false) -- ~47% opacite, local only
                            local camRot = GetGameplayCamRot(2)
                            SetEntityRotation(ped, camRot.x, 0.0, camRot.z, 2, true)
                            _lastOmniPose = true

                        else
                            -- Pose 1 ou 2 : reset alpha si on venait de pose 4
                            if _lastOmniPose then
                                ResetEntityAlpha(ped)
                                _lastOmniPose = false
                            end

                            -- Posture standing naturelle propre en pose 2 (anti T-Pose sans toucher a SetEntityCoordsNoOffset)
                            if pose == 2 and not isShooting and not IsPedInAnyVehicle(ped, false) then
                                local dictStand = "amb@world_human_stand_guard@male@base"
                                RequestAnimDict(dictStand)
                                if HasAnimDictLoaded(dictStand) then
                                    if not IsEntityPlayingAnim(ped, dictStand, "base", 3) then
                                        TaskPlayAnim(ped, dictStand, "base", 8.0, -8.0, -1, 1, 0.0, false, false, false)
                                    end
                                end
                            end
                        end
                    else
                        -- En vehicule : reset alpha si besoin
                        if _lastOmniPose then
                            ResetEntityAlpha(ped)
                            _lastOmniPose = false
                        end
                    end

                    Citizen.Wait(0)
                    end -- ped guard
                end
                -- Noclip desactive : reset alpha au cas ou on etait en OmniMove
                local ped2 = PlayerPedId()
                ResetEntityAlpha(ped2)
            end)

            while Menu.State.noclipActive do
                local ped = PlayerPedId()
                if not ped or ped == 0 then Citizen.Wait(100)
                else
                local veh = GetVehiclePedIsIn(ped, false)
                local inVehicle = (veh and veh ~= 0)
                local entity = inVehicle and veh or ped
                local pose = Menu.State.noclipPose or 1

                -- EntrÃ©e dans un vÃ©hicule : orienter selon camÃ©ra
                if inVehicle and veh ~= lastVehForCam then
                    local camRot2 = GetGameplayCamRot(2)
                    SetEntityRotation(veh, 0.0, 0.0, camRot2.z, 2, true)
                    lastVehForCam = veh
                elseif not inVehicle then
                    lastVehForCam = 0
                end

                -- Visibilite
                local isInvis = (pose == 1) and not Menu.State.bypassSeedActive
                if inVehicle and veh ~= lastVeh then
                    if lastVeh ~= 0 and DoesEntityExist(lastVeh) then SetEntityVisible(lastVeh, true, false) end
                    SetEntityVisible(veh, not isInvis, false)
                    lastVeh = veh
                elseif not inVehicle and lastVeh ~= 0 then
                    if DoesEntityExist(lastVeh) then SetEntityVisible(lastVeh, true, false) end
                    lastVeh = 0
                end
                SetEntityVisible(ped, not isInvis, false)

                -- Collision + freeze (mouvement original rapide)
                SetEntityCollision(entity, false, false)
                FreezeEntityPosition(entity, true)
                if inVehicle then
                    SetEntityCollision(ped, false, false)
                    FreezeEntityPosition(ped, true)
                end

                local coords = GetEntityCoords(entity)
                local camRot = GetGameplayCamRot(2)
                local pitch = math.rad(camRot.x)
                local yaw   = math.rad(camRot.z)
                local vx = -math.sin(yaw) * math.abs(math.cos(pitch))
                local vy =  math.cos(yaw) * math.abs(math.cos(pitch))
                local vz =  math.sin(pitch)
                local rx =  math.cos(yaw)
                local ry =  math.sin(yaw)

                currentSpeed = (Menu.State.noclipSpeed or 5.0) / 5.0
                local moveSpeed = currentSpeed
                if IsDisabledControlPressed(0, 21) then moveSpeed = currentSpeed * 2.5 end

                local newPos = coords
                if IsDisabledControlPressed(0, 32) then newPos = vector3(newPos.x + vx * moveSpeed, newPos.y + vy * moveSpeed, newPos.z + vz * moveSpeed) end
                if IsDisabledControlPressed(0, 33) then newPos = vector3(newPos.x - vx * moveSpeed, newPos.y - vy * moveSpeed, newPos.z - vz * moveSpeed) end
                if IsDisabledControlPressed(0, 34) then newPos = vector3(newPos.x - rx * moveSpeed, newPos.y - ry * moveSpeed, newPos.z) end
                if IsDisabledControlPressed(0, 35) then newPos = vector3(newPos.x + rx * moveSpeed, newPos.y + ry * moveSpeed, newPos.z) end
                if IsDisabledControlPressed(0, 22) then newPos = vector3(newPos.x, newPos.y, newPos.z + moveSpeed) end
                if IsDisabledControlPressed(0, 36) then newPos = vector3(newPos.x, newPos.y, newPos.z - moveSpeed) end

                pcall(SetEntityCoordsNoOffset, entity, newPos.x, newPos.y, newPos.z, true, true, true)

                if inVehicle then
                    SetEntityHeading(veh, camRot.z)
                    SetEntityRotation(veh, 0.0, 0.0, camRot.z, 2, false)
                else
                    -- OmniMove (pose 4) : la rotation complete est geree par le thread de pose (pitch+yaw)
                    -- On ne set que le heading pour les autres poses
                    if pose ~= 4 then
                        SetEntityHeading(ped, camRot.z)
                    end
                end

                Citizen.Wait(0)
                end -- ped guard
            end

            -- Desactivation : tout nettoyer
            local ped = PlayerPedId()
            local veh = GetVehiclePedIsIn(ped, false)
            local entity = (veh and veh ~= 0) and veh or ped
            SetEntityCollision(entity, true, true)
            FreezeEntityPosition(entity, false)
            SetEntityCollision(ped, true, true)
            FreezeEntityPosition(ped, false)
            SetEntityVisible(ped, true, false)
            ResetEntityAlpha(ped) -- reset translucide OmniMove si actif
            -- Reset poses
            SetPedCanPlayGestureAnims(ped, true)
            StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
            StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
            ClearPedTasks(ped)
            if veh and veh ~= 0 and DoesEntityExist(veh) then
                SetEntityVisible(veh, true, false)
                SetEntityCollision(veh, true, true)
                FreezeEntityPosition(veh, false)
            end
        end)
        ShowDynastyNotification("[ NOCLIP ] Active  -  [M] to disable")
    else
        local ped = PlayerPedId()
        SetEntityVisible(ped, true, false)
        ResetEntityAlpha(ped) -- reset translucide OmniMove si actif
        -- Reset poses
        SetPedCanPlayGestureAnims(ped, true)
        StopAnimTask(ped, "amb@world_human_yoga@male@idle_a", "idle_a", 4.0)
        StopAnimTask(ped, "anim@mp_player_intcelebrationmale@waving_arms", "waving_arms", 4.0)
        ClearPedTasks(ped)
        local veh = GetVehiclePedIsIn(ped, false)
        if veh and veh ~= 0 and DoesEntityExist(veh) then SetEntityVisible(veh, true, false) end
        ShowDynastyNotification("[ NOCLIP ] Disabled")
    end
end

