function Menu.Helpers.GetKeyName(vk, ctrlId)
    local name = nil
    if vk and _G.VK_NAMES[vk] then name = _G.VK_NAMES[vk]
    elseif ctrlId and _G.ControlNamesMap[ctrlId] then name = _G.ControlNamesMap[ctrlId]
    elseif vk then name = "K" .. tostring(vk)
    elseif ctrlId then name = "C" .. tostring(ctrlId)
    else name = "?" end

    -- Diminutifs ultra-propres pour éviter les chevauchements dans le HUD
    name = string.gsub(name, "MOUSE BUTTON ", "M")
    name = string.gsub(name, "MOUSE ", "M")
    name = string.gsub(name, "CLIC GAUCHE", "M1")
    name = string.gsub(name, "CLIC DROIT", "M2")
    name = string.gsub(name, "MOLETTE", "M3")
    name = string.gsub(name, "LOOK BEHIND", "LOOK")
    name = string.gsub(name, "SCROLL UP", "MWUP")
    name = string.gsub(name, "SCROLL DOWN", "MWDN")
    name = string.gsub(name, "PAGE HAUT", "PGUP")
    name = string.gsub(name, "PAGE BAS", "PGDN")
    name = string.gsub(name, "PAGEUP", "PGUP")
    name = string.gsub(name, "PAGEDOWN", "PGDN")
    name = string.gsub(name, "VERR.MAJ", "CAPS")
    name = string.gsub(name, "CAPSLOCK", "CAPS")
    name = string.gsub(name, "IMPR.ECR", "PRTSC")
    name = string.gsub(name, "ENTREE", "ENTER")
    name = string.gsub(name, "RETOUR", "BACK")
    name = string.gsub(name, "GAUCHE", "LEFT")
    name = string.gsub(name, "DROITE", "RIGHT")
    name = string.gsub(name, "HAUT", "UP")
    name = string.gsub(name, "BAS", "DOWN")
    name = string.gsub(name, "L%-SHIFT", "LSHIFT")
    name = string.gsub(name, "R%-SHIFT", "RSHIFT")
    name = string.gsub(name, "L%-CTRL", "LCTRL")
    name = string.gsub(name, "R%-CTRL", "RCTRL")
    name = string.gsub(name, "L%-ALT", "LALT")
    name = string.gsub(name, "R%-ALT", "RALT")
    return name
end

function Menu.Helpers.GetFullListForMenu(menu)
    local menu = menu or (Menu.State and Menu.State.currentMenu) or "MAIN"
    local fullList = {}
    if menu == "MAIN" then fullList = Menu.Data.Options.Main
    elseif menu == "PLAYER" then fullList = Menu.Helpers.GetPlayerOptions()
    elseif menu == "MOVEMENT" then fullList = Menu.Helpers.GetMovementOptions()
    elseif menu == "ONLINE" then fullList = Menu.Helpers.GetOnlineMenuList()
    elseif menu == "TROLL" then fullList = Menu.Data.Options.Troll and Menu.Data.Options.Troll.Categories[Menu.State.trollTab or 1] or {}
    elseif menu == "COMBAT" then fullList = Menu.Data.Options.Combat and Menu.Data.Options.Combat.Categories[Menu.State.combatTab or 1] or {}
    elseif menu == "VEHICLE" then
        if Menu.State.vehicleTab == 1 then fullList = Menu.Helpers.GetVehicleMenuList()
        else fullList = Menu.Data.Options.Vehicle and Menu.Data.Options.Vehicle.Categories[Menu.State.vehicleTab or 1] or {} end
    elseif menu == "MISC" then fullList = Menu.Helpers.GetMiscOptions()
    elseif menu == "PROPS" then fullList = Menu.Helpers.GetPropsOptions()
    elseif menu == "TP_PASSAGER" then fullList = Menu.Helpers.GetTpPassagerOptions()
    elseif menu == "COL_SCENARIO" then fullList = Menu.Helpers.GetColScenarioOptions()
    elseif menu == "DYNA" then fullList = Menu.Helpers.GetDynaOptions()
    elseif menu == "VIP" then fullList = Menu.Helpers.GetVipOptions()
    elseif menu == "VIP_PED" then fullList = Menu.Helpers.GetPedOptions()
    elseif menu == "VIP_GIVE" then fullList = Menu.Helpers.GetDynaGiveOptions()
    elseif _vipGiveCatKey and _vipGiveCatKey[menu] then fullList = Menu.Helpers.GetVipGiveCatOptions(menu)
    elseif menu == "VIP_RESOURCE" then fullList = Menu.Helpers.GetResourceManagerOptions()
    elseif menu == "VISUAL" then fullList = Menu.Data.Options.Visual and Menu.Data.Options.Visual.Categories[Menu.State.visualTab or 1] or {}
    elseif menu == "WEAPON" then fullList = Menu.Helpers.GetWeaponOptions()
    elseif menu == "WARDROBE" then fullList = Menu.Helpers.GetWardrobeOptions()
    elseif menu == "SETTINGS" then fullList = Menu.Helpers.GetSettingsOptions()
    elseif menu == "SETTINGS_RENDER" then fullList = Menu.Helpers.GetSettingsRenderOptions()
    elseif menu == "SETTINGS_UTILITY" then fullList = Menu.Helpers.GetSettingsUtilityOptions()
    elseif menu == "KEYBINDS" then fullList = Menu.Helpers.GetKeybindOptions()
    elseif menu == "ACTIVE_BINDS" then fullList = Menu.Helpers.GetActiveBindsOptions()
    elseif menu == "CONFIGS" then fullList = Menu.Helpers.GetConfigsOptions()
    elseif menu == "CONFIG_OPTIONS" then fullList = Menu.Helpers.GetConfigOptionsSub()
    end
    return fullList or {}
end

