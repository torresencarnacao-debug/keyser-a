function RenderBindingUI()
    -- Bloquer l'affichage tant que les deux loadings ne sont pas termines
    if Menu.State.isLoading then return end
    if Menu.State.showLoading then return end
    if not Keyser or not Keyser.DrawRectFilled or not Keyser.GetTextWidth then return end

    local sw, sh = GetActiveScreenResolution()
    local cx, cy = sw / 2, sh / 2
    local padding = 28
    -- Couleur accent adaptee a la banniere (MIRAGE breathing si MirageLua)
    local accentR, accentG, accentB
    if _G.IsMirageLuaActive and _G.IsMirageLuaActive() and _G.MirageBreathColor then
        local _cr, _cg, _cb = _G.MirageBreathColor(GetGameTimer())
        accentR, accentG, accentB = _cr/255.0, _cg/255.0, _cb/255.0
    else
        local _themeRGB = Menu.Colors and Menu.Colors.HeaderPink or {r=255,g=255,b=255}
        accentR = (_themeRGB.r or 255) / 255.0
        accentG = (_themeRGB.g or 255) / 255.0
        accentB = (_themeRGB.b or 255) / 255.0
    end
    if (accentR + accentG + accentB) < 0.3 then
        accentR, accentG, accentB = 1.0, 1.0, 1.0
    end

    -- ── CUSTOM KEYBOARD INPUT FOR CONFIG PROFILES ──────────────────────
    if _G.CustomInputActive and _G.CustomInputState then
        local now = GetGameTimer()
        local title = "CONFIGURATIONS"
        local sub = _G.CustomInputState.title or "Entrez le nom de la config"
        local buf = _G.CustomInputState.inputBuffer or ""
        local showCursor = ((now % 1000) < 500)
        local displayStr = buf .. (showCursor and "|" or " ")

        local thumbTex = _G._loadingTex or _G._bannerTex
        local thumbSize = thumbTex and 72.0 or 0.0
        local thumbPad = thumbTex and 14.0 or 0.0

        local uiW = 420
        local uiH = thumbSize + thumbPad + 160
        local x = cx - uiW / 2
        local y = cy - uiH / 2

        Menu.Helpers.DrawHollowBorderRect(x, y, uiW, uiH, accentR, accentG, accentB, 0.8, 0.82, 10.0)

        if thumbTex and Keyser.DrawImage then
            Keyser.DrawImage(thumbTex, cx - thumbSize / 2, y + thumbPad, thumbSize, thumbSize, 1, 1, 1, 1, 8.0, 0, 0, 1, 1)
        end

        local off = thumbSize + thumbPad
        local function ct(txt, size, yOff, r, g, b, a)
            local tw = Keyser.GetTextWidth(txt, size)
            Keyser.DrawText(cx - tw / 2, y + off + yOff, txt, size, r, g, b, a or 1)
        end

        ct(title, 22, 10, 1, 1, 1, 1)
