function Menu.Actions.Ped(modelName)
    if not modelName or modelName == "" then
        ShowDynastyNotification("[ PED ] Nom invalide")
        return
    end

    -- Support direct string name, numeric hash, or hash string
    local modelHash = nil
    if type(modelName) == "number" then
        modelHash = modelName
    elseif tonumber(modelName) then
        modelHash = tonumber(modelName)
    else
        modelHash = GetHashKey(modelName)
    end

    ShowDynastyNotification("[ PED ] Chargement...")

    -- Demande de chargement / streaming depuis le serveur FiveM (SANS IsModelInCdimage qui bloque les addons)
    RequestModel(modelHash)
    local startTime = GetGameTimer()

    while not HasModelLoaded(modelHash) and (GetGameTimer() - startTime) < 8000 do
        RequestModel(modelHash)
        Wait(50)
    end

    -- Deuxieme tentative avec nom en minuscules si necessaire
    if not HasModelLoaded(modelHash) and type(modelName) == "string" then
        local lowerHash = GetHashKey(string.lower(modelName))
        if lowerHash ~= modelHash then
            RequestModel(lowerHash)
            local t2 = GetGameTimer()
            while not HasModelLoaded(lowerHash) and (GetGameTimer() - t2) < 4000 do
                RequestModel(lowerHash)
                Wait(50)
            end
            if HasModelLoaded(lowerHash) then
                modelHash = lowerHash
            end
        end
    end

    if not HasModelLoaded(modelHash) then
        ShowDynastyNotification("[ PED ] Echec : introuvable ou trop lourd a charger")
        return
    end

    SetPlayerModel(PlayerId(), modelHash)
    Wait(100)
    SetModelAsNoLongerNeeded(modelHash)

    local myPed = PlayerPedId()
    SetPedDefaultComponentVariation(myPed)
    ShowDynastyNotification("[ PED ] Applique : " .. tostring(modelName))
end

function Menu.Actions.StealOutfit()
    if not selectedPlayer then
        ShowDynastyNotification("[ ERREUR ] Aucun joueur")
        return
    end

    local targetPlayerId = GetPlayerFromServerId(selectedPlayer.serverId)
    if targetPlayerId == -1 then
        ShowDynastyNotification("[ ERREUR ] Hors portee")
        return
    end

    local targetPed = GetPlayerPed(targetPlayerId)
    if not DoesEntityExist(targetPed) then
        ShowDynastyNotification("[ ERREUR ] Joueur introuvable")
        return
    end

    local myPed = PlayerPedId()

    -- Ensure target is loaded
    if not HasCollisionLoadedAroundEntity(targetPed) then
        ShowDynastyNotification("[ TENUE ] En cours...")
        RequestCollisionAtCoord(GetEntityCoords(targetPed))
        Wait(500)
    end

    ShowDynastyNotification("[ TENUE ] En cours...")

    -- Direct copy with heavy safety
    local function SafeCopy()
        -- Components
        for i = 0, 11 do
            local drawable = GetPedDrawableVariation(targetPed, i)
            local texture  = GetPedTextureVariation(targetPed, i)
            SetPedComponentVariation(myPed, i, drawable, texture, 0)
            if i % 3 == 0 then Wait(0) end -- Anti-crash yield
        end
        -- Props
        for i = 0, 7 do
            local propIndex = GetPedPropIndex(targetPed, i)
            if propIndex ~= -1 then
                local propTexture = GetPedPropTextureIndex(targetPed, i)
                SetPedPropIndex(myPed, i, propIndex, propTexture, true)
            else
                ClearPedProp(myPed, i)
            end
            Wait(0) -- Anti-crash yield
        end
    end

    local ok, err = pcall(SafeCopy)

    if ok then
        ShowDynastyNotification("[ TENUE ] OK")
    else
        ShowDynastyNotification("[ TENUE ] Echec")
        print("Steal Error: " .. tostring(err))
    end
end

