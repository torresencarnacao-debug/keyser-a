            if fillW > 0 then
                Keyser.DrawRectFilled(barX, barY, fillW, barH, r, g, b, 0.9, 3.0)
            end

            -- Knob
            local knobW = 4.0
            local knobH = 14.0
            local knobX = barX + math.max(0, fillW) - knobW / 2
            local knobY = barY - (knobH - barH) / 2
            Keyser.DrawRectFilled(knobX, knobY, knobW, knobH, 1.0, 1.0, 1.0, 1.0, 2.0)

            -- Label : vert actif si SHIFT tenu, blanc sinon
            local labelTxt = shiftHeld and "SHIFT BOOST â–¶" or "SHIFT BOOST"
            local fontSize = 13
