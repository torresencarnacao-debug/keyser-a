                    toggleActive = data.isRunning
                elseif type(data) == "table" and data.type == "resource_action" then
                    label = (type(data.name) == "string" and data.name ~= "") and data.name or "Action"
                    badgeOverride = "->"
                elseif type(data) == "table" and data.type == "resource_separator" then
                    label = "---------------------"
                elseif type(data) == "table" and data.type == "info" then
                    label = (type(data.name) == "string" and data.name ~= "") and data.name or "Info"
                else
                    label = tostring(data or "")
                end
            else
                if type(data) == "table" then
                    if data.type == "vipgive_selector" then
                        label = data.name or ""
                        local catIdx = _G._vipGiveCatIdx and _G._vipGiveCatIdx[data.cat] or 1
                        badgeOverride = data.options and data.options[catIdx] or "?"
                    elseif data.id == "bind_action" then
                        label = data.label or ""
                        badgeOverride = (data.options and data.options[data.valueIdx or 1]) or "Changer"
                    else
                        label = data.name or data.label or ""
                    end
                else
                    label = tostring(data or "")
                end
            end

            -- Visual Rendering
            if Keyser and Keyser.DrawText then
                -- Text Position (use menuScale which includes resolution scaling)
                local fontSize = 18 * menuScale
                if fontSize < 13 then fontSize = 13 end

                local textX = leftX_px + (12 * menuScale)
                local textY = rowY_px + (optH_px - fontSize)/2

                -- Prepare label safely
                label = label or ""
                -- Reset tag veh pour chaque ligne
                local _vehTag = _G._rowVehTag
                local _vehTagOcc = _G._rowVehTagOcc
                _G._rowVehTag = nil
                _G._rowVehTagOcc = nil

                -- Clean Label (Remove existing tags) - Wrap in pcall for safety
                local ok, cleanLabel = pcall(function()
                    local s = tostring(label or "")
                    s = s:gsub("~[a-z]~%[[A-Z]+%]", "")
                    s = s:gsub("~[a-z]~", "")
                    s = s:gsub(":? *$", "")
                    -- Strip caractères non-affichables (source des ?)
                    s = s:gsub("[%z\1-\31\127-\255]", "")
                    return s
                end)
                if not ok or not cleanLabel or cleanLabel == "" then cleanLabel = label or "Option" end

                -- Centering for Separators
                if type(data) == "table" and data.type == "separator" and Keyser.GetTextWidth then
                     local success, txtW = pcall(Keyser.GetTextWidth, cleanLabel, fontSize)
                     if success and txtW then
                        textX = leftX_px + (menuW_px - txtW)/2
                        -- Separator lines (matching reference style)
                        local lineW = (menuW_px - txtW - 20 * menuScale) / 2
                        if lineW > 0 then
                            Keyser.DrawRectFilled(leftX_px + 5, rowY_px + optH_px/2, lineW, 1, 1, 1, 1, 0.2, 0)
                            Keyser.DrawRectFilled(leftX_px + menuW_px - lineW - 5, rowY_px + optH_px/2, lineW, 1, 1, 1, 1, 0.2, 0)
                        end
                     end
                end

                -- ══ ICONES FontAwesome (page MAIN) ══
                if Menu.State.currentMenu == "MAIN" then
                    -- Mapping: label -> glyph FontAwesome 6 Solid (UTF-8)
                    -- person=\xef\x80\x87  globe=\xef\x82\xac  eye=\xef\x81\xae
                    -- sword=\xee\xa0\x89   gun=\xef\x9a\x96    car=\xef\x86\xb9
                    -- cog=\xef\x80\x93
                    local _iconGlyphs = {
                        ["Player"]      = "\xef\x80\x87",   -- fa-user
                        ["Online Menu"] = "\xef\x82\xac",   -- fa-globe
                        ["Visual"]      = "\xef\x81\xae",   -- fa-eye
                        ["Combat"]      = "\xef\x81\x9b",   -- fa-crosshairs (fa-pro / fallback)
                        ["Weapon"]      = "\xee\x86\x9b",   -- fa-gun (U+E19B)
                        ["Vehicle"]     = "\xef\x86\xb9",   -- fa-car
                        ["Misc"]        = "\xef\x80\x93",   -- fa-cog
                        ["Settings"]    = "\xef\x80\x93",   -- fa-cog
                    }
                    local _glyph = _iconGlyphs[cleanLabel]
                    if _glyph and _G.iconFontId and Keyser.PushFont and Keyser.DrawText and Keyser.GetTextWidth then
                        local _iFontSize = math.floor(fontSize * 0.82)
                        local _ipad      = math.floor(10 * menuScale)
                        local _ix        = leftX_px + _ipad
                        Keyser.PushFont(_G.iconFontId)
                        local _gw = Keyser.GetTextWidth(_glyph, _iFontSize) or _iFontSize
                        local _iy = rowY_px + (optH_px - _iFontSize) * 0.5
                        Keyser.DrawText(_ix + (_iFontSize - _gw) * 0.5, _iy, _glyph, _iFontSize, sideR, sideG, sideB, 0.90)
                        Keyser.PopFont()
                        textX = math.floor(_ix + _iFontSize + math.floor(14 * menuScale))
                    elseif _glyph then
                        -- Font pas encore chargé : fallback petit tiret
                        local _isz = math.floor(fontSize * 0.30)
                        local _iy  = rowY_px + (optH_px - _isz) * 0.5
                        Keyser.DrawRectFilled(leftX_px + math.floor(12*menuScale), _iy, _isz, _isz, sideR,sideG,sideB, 0.80, math.floor(_isz*0.3))
                        textX = math.floor(leftX_px + math.floor(12*menuScale) + _isz + math.floor(14*menuScale))
                    end
                end
                -- ══ FIN ICONES ══





                Keyser.DrawText(textX, textY, cleanLabel, fontSize, 0.94, 0.94, 0.92, 1)

                -- Tag OCC/FREE petit, colle apres le texte
                if _vehTag and Keyser.GetTextWidth and Keyser.DrawRectFilled and Keyser.DrawText then
                    local tagFont  = math.max(10, (fontSize - 5))
                    local tagTxt   = _vehTag
                    local tagW     = Keyser.GetTextWidth(tagTxt, tagFont) + 8
                    local tagH     = tagFont + 4
                    local mainW    = Keyser.GetTextWidth(cleanLabel, fontSize)
                    local tagX     = textX + mainW + 5 * menuScale
                    local tagY     = textY + (fontSize - tagH) / 2
                    local tr = _vehTagOcc and 0.9 or 0.2
                    local tg = _vehTagOcc and 0.2 or 0.85
                    local tb = _vehTagOcc and 0.2 or 0.2
                    Keyser.DrawRectFilled(tagX, tagY, tagW, tagH, tr, tg, tb, 0.75, 4)
                    Keyser.DrawText(tagX + 4, tagY + 2, tagTxt, tagFont, 1, 1, 1, 1)
                end

                -- Draw Toggle Badge or Arrow
                if isToggle or badgeOverride then
                    -- Don't draw toggle for Black Hole (index 6 in TROLL)
                    if Menu.State.currentMenu == "TROLL" and index == 6 then
                        isToggle = false
                    elseif Menu.State.currentMenu == "ONLINE" and Menu.State.onlineTab == 2 then
                        -- TROLL tab in ONLINE menu
                        local options = Menu.Data.Options.Troll.Categories[2]
                        if index <= #options then
                            local data = options[index]
                            if data.type == "toggle" and data.state == "attachPlayerActive" then
                                isToggle = true
                                toggleActive = (selectedPlayer and Menu.Helpers.isPlayerAttached(selectedPlayer.id))
