local function ESP_DrawCornerBox(x1,y1,x2,y2,r,g,b,a,sw,sh)
    if not Keyser or not Keyser.DrawLine then return end
    local px1, py1 = x1 * sw, y1 * sh
    local px2, py2 = x2 * sw, y2 * sh
    local w = px2 - px1
    local h = py2 - py1
    -- Longueur des coins : 22% de la dimension, min 4px
    local cw = math.max(4, w * 0.22)
    local ch = math.max(4, h * 0.22)

    local function drawCorner(cx, cy, sdx, sdy)
        -- Ombre (outline noire epaisse)
        Keyser.DrawLine(cx, cy, cx + sdx * cw, cy,          0,0,0,1,3)
        Keyser.DrawLine(cx, cy, cx,             cy + sdy*ch, 0,0,0,1,3)
        -- Couleur principale
        Keyser.DrawLine(cx, cy, cx + sdx * cw, cy,          r,g,b,a,1.5)
        Keyser.DrawLine(cx, cy, cx,             cy + sdy*ch, r,g,b,a,1.5)
    end

    drawCorner(px1, py1,  1,  1) -- Coin haut-gauche
    drawCorner(px2, py1, -1,  1) -- Coin haut-droit
    drawCorner(px1, py2,  1, -1) -- Coin bas-gauche
    drawCorner(px2, py2, -1, -1) -- Coin bas-droit
end

